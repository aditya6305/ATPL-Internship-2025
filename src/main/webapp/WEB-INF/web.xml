<servlet-name>StudentServlet_aditya</servlet-name>
<url-pattern>/StudentServlet_aditya</url-pattern>
</servlet-mapping>
<servlet>
<servlet-name>LogoutServlet_aditya</servlet-name>
<servlet-class>controller.LogoutServlet_aditya</servlet-class>
</servlet>
